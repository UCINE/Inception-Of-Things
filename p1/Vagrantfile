Vagrant.configure("2") do |config|

  
  config.vm.define "bmakhlouS" do |bmakhlouS|
    bmakhlouS.vm.box = "generic/alpine319"
    bmakhlouS.vm.network "private_network", ip: "192.168.56.110"
    bmakhlouS.vm.hostname = "bmakhlouS"
    bmakhlouS.vm.provider "virtualbox" do |vb|
      vb.name = "bmakhlouS"
      vb.memory = 1024
      vb.cpus = 1
    end
    bmakhlouS.vm.provision "shell", path: "./scripts/master.sh"
  end
  
  config.vm.define "bmakhlouSW" do |bmakhlouSW|
    bmakhlouSW.vm.box = "generic/alpine319"
    bmakhlouSW.vm.network "private_network", ip: "192.168.56.111"
    bmakhlouSW.vm.hostname = "bmakhlouSW"
    bmakhlouSW.vm.provider "virtualbox" do |vb|
      vb.name = "bmakhlouSW"
      vb.memory = 1024
      vb.cpus = 1
    end
    bmakhlouSW.vm.provision "shell", path: "./scripts/worker.sh"
  end


  config.vm.synced_folder "./confs", "/vagrant"
end
